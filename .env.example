# Copy to .env and fill in. Secrets are only ever read from environment variables.

# Remote LLM (DeepSeek, OpenAI-compatible)
DEEPSEEK_API_KEY=

# Langfuse Cloud (optional; tracing degrades silently when unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Teacher for training data generation (training/configs/inference/teacher_openai.yaml)
OPENAI_API_KEY=
# Optional: override the Teacher model set in the YAML
TEACHER_MODEL=
